{
  "manifest_version": 3,
  "name": "Podcast Sync",
  "version": "0.1.0",
  "description": "Keeps YouTube and Apple Podcasts at the same spot in an episode.",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1:47321/*"
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "toast.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "captions.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Podcast Sync"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
